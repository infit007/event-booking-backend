# -----------------------------------------------------------------------------
# Event Booking System API - Environment Variables
# -----------------------------------------------------------------------------

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Performance Mode: 'baseline' (naive, sync email, pool 5) | 'optimized' (CTE, Redis cache, BullMQ async, pool 25)
APP_MODE=optimized

# PostgreSQL Database Connection URL (Supports Neon, Supabase, Render, Local)
# Example: postgresql://postgres:password@localhost:5432/event_booking
DATABASE_URL=postgresql://user:password@localhost:5432/event_booking?sslmode=disable

# Redis Connection URL (Supports Upstash rediss://, Redis Cloud, Local)
# Example: redis://localhost:6379 OR rediss://default:token@cluster.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-key-replace-with-64-char-random-in-production
JWT_EXPIRES_IN=7d

# Real Email Service Provider ('resend' | 'smtp')
EMAIL_PROVIDER=resend
EMAIL_FROM=onboarding@resend.dev

# Resend API Key (Required if EMAIL_PROVIDER=resend)
# Get a free key at https://resend.com
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# SMTP Credentials (Required if EMAIL_PROVIDER=smtp, e.g. Mailgun, SendGrid, Brevo, AWS SES)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Stress Testing Safeguard
# Set to true during 10,000+ request load tests to simulate 250ms SMTP network I/O
# without burning Resend/SMTP daily API quotas. Keeps real email active when false (default).
LOAD_TEST_SKIP_EXTERNAL_EMAIL=false
